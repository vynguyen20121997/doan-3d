# Sao chép tệp này thành .env rồi sửa cho khớp máy của bạn.

# Cổng máy chủ web/API
PORT=3000

# Kết nối PostgreSQL + PostGIS
# (cổng 55432 là bản portable dựng theo hướng dẫn ở db/README.md)
PGHOST=127.0.0.1
PGPORT=55432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=chamcong3d

# Khoá ký JWT — môi trường thật phải đổi thành chuỗi ngẫu nhiên đủ dài
JWT_SECRET=ie402-chamcong-3d-doi-khi-trien-khai-that
